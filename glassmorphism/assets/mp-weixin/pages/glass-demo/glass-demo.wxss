@import "../../styles/glass.wxss";

/* ---------- 页面骨架 ---------- */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.content {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

/* ---------- 文本（Skyline 下 text 默认 inline，需要 block） ---------- */
.t-nav {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.t-navsub {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* ---------- 1. 圆角卡片 ---------- */
.card {
  margin-top: 40rpx;
  padding: 36rpx 40rpx 32rpx;
}

.tag {
  display: flex;
  flex-direction: row;
  align-self: flex-start;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.t-tag {
  color: rgba(255, 255, 255, 0.85);
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.t-title {
  display: block;
  margin-top: 26rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
}

.t-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  line-height: 1.55;
}

.meta {
  display: flex;
  flex-direction: row;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.meta__item {
  flex: 1;
}

.meta__item--line {
  border-right: 1rpx solid rgba(255, 255, 255, 0.12);
}

.t-num {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.t-lbl {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---------- 分区标题 ---------- */
.sec {
  margin-top: 40rpx;
}

.sec__head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20rpx;
}

.t-sec {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.t-hint {
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
}

/* ---------- 2. 圆形头像 ---------- */
.row {
  display: flex;
  flex-direction: row;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  padding: 6rpx;
}

.avatar--lg {
  width: 148rpx;
  height: 148rpx;
  padding: 8rpx;
}

.avatar--gap {
  margin-left: 24rpx;
}

.avatar--add {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar__img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.t-plus {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 300;
}

/* ---------- 3. 横向玻璃集合 ---------- */
.item {
  flex: 1;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item--gap {
  margin-left: 22rpx;
}

.t-item {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* ---------- 4. 胶囊标签 ---------- */
.chips {
  margin-top: 36rpx;
}

.chip {
  padding: 12rpx 24rpx;
}

.chip--gap {
  margin-left: 16rpx;
}

.t-chip {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

/* ---------- 提示行 ---------- */
.note {
  margin-top: 32rpx;
  padding-left: 8rpx;
}

.t-note {
  color: rgba(255, 255, 255, 0.38);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---------- 5. 底部 dock ---------- */
.dock {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding: 20rpx 24rpx;
}

.dock__left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cover {
  width: 84rpx;
  height: 84rpx;
  padding: 4rpx;
}

.cover__img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.dock__txt {
  margin-left: 20rpx;
}

.t-docktitle {
  display: block;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.t-dockdesc {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
}

.play {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.t-play {
  color: #ffffff;
  font-size: 26rpx;
  margin-left: 4rpx;
}
